<html lang="en">
<head>
    <link rel="stylesheet" href="/styles.css">
    <title>Document</title>
</head>
<body>
    <h1 >Message Board</h1>
    <ul>
        <% messages.forEach((message) => { %>
            <%- include('message', {message: message}); %>
        <% }); %>
    </ul>
    <div id="newMessage">
        <button type="button" > <a href="/new">New Message</a></button>
    </div>
</body>
</html>